# Analysis worker: the LLM key and nothing else. If a GitHub variable appears here the worker
# refuses to start.
PRI_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key
PRI_SERVICE_REVIEWER=a2
PRI_MAX_REQUESTS_PER_RUN=30
# Free-tier pacing: requests per minute across this worker.
PRI_LLM_REQUESTS_PER_MINUTE=10
