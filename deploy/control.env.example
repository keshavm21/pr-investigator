# Control plane (web + fetcher): holds the GitHub credentials. Never give this file to the worker.
PRI_BASE_URL=https://pri.example.com

GITHUB_APP_ID=123456
# The private key is mounted from deploy/github-app.pem (see compose.yaml), not set here.
GITHUB_WEBHOOK_SECRET=change-me-long-random-string
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=change-me

# Admission policy. Closed by default: list the repositories to analyze ("owner/name", comma-separated).
PRI_ALLOWED_REPOS=your-name/your-test-repo
PRI_ALLOW_PRIVATE=false
PRI_MAX_CHANGED_FILES=100
PRI_MAX_CHANGED_LINES=5000
PRI_DAILY_RUNS_PER_INSTALLATION=20
