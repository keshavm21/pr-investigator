{"case_id":"seeded-werkzeug-password-compare","kind":"seeded","sample":1,"findings":[{"id":"F1","title":"Replacing hmac.compare_digest with standard equality operator (==) introduces a timing attack vulnerability in password hash verification.","category":"security","severity":"high","confidence":"high","anchor":{"path":"src/werkzeug/security.py","side":"RIGHT","start_line":146,"end_line":146},"explanation":"Using standard equality (`==`) to compare password hashes or secrets leaks timing information about how many characters match from the beginning, which can allow an attacker to recover password hashes character by character via timing attacks. Cryptographic comparisons should always use constant-time comparison functions such as `hmac.compare_digest`.","suggested_fix":"Restore hmac.compare_digest(_hash_internal(method, salt, password)[0], hashval)","anchor_in_diff":true,"evidence":[{"role":"defect_site","observation_id":"O1","note":"The password hash comparison uses standard == operator instead of constant-time hmac.compare_digest","ref":"head","path":"src/werkzeug/security.py","start_line":146,"end_line":146,"snippet":"    return _hash_internal(method, salt, password)[0] == hashval","query":null}]}],"matches":[{"finding_id":"F1","issue_id":"timing","distance":0,"verdict":"match","rationale":"location-only matching"}],"expected_total":1,"decoy_hits":[],"review_usage":{"input_tokens":11085,"output_tokens":339,"thinking_tokens":0,"cached_input_tokens":0},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":false,"requests":3,"cached_requests":0,"agent":{"suspects":0,"dropped_suspects":0,"outcomes":{},"stop_causes":{"submitted":1},"turns":3,"tool_calls":2,"rejections":0,"duplicates":0,"retries":0},"duration_seconds":19.554,"error":null}
