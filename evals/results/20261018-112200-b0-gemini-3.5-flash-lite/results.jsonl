{"case_id":"seeded-inventory-cancel-order","kind":"seeded","sample":0,"findings":[{"id":"F1","title":"SQL Injection vulnerability via cancel_reason","category":"security","severity":"critical","confidence":"high","anchor":{"path":"app/routes/orders.py","side":"RIGHT","start_line":51,"end_line":51},"explanation":"The cancel_reason string from the request JSON is interpolated directly into the SQL update string instead of being passed as a query parameter. An attacker can supply a malicious string containing SQL commands to manipulate the database.","suggested_fix":"Use parameterized queries for the cancel_reason, e.g., db.execute(\"UPDATE orders SET status = 'cancelled', cancel_reason = ? WHERE id = ?\", (reason, int(order_id)))","anchor_in_diff":true,"evidence":[]}],"matches":[{"finding_id":"F1","issue_id":"sqli","distance":0,"verdict":"match","rationale":"location-only matching"}],"expected_total":2,"decoy_hits":[],"review_usage":{"input_tokens":941,"output_tokens":230,"thinking_tokens":0,"cached_input_tokens":0},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":false,"requests":1,"cached_requests":0,"agent":null,"duration_seconds":1.726,"error":null}
{"case_id":"seeded-inventory-set-role","kind":"seeded","sample":0,"findings":[{"id":"F1","title":"Missing check for whether the updated user exists","category":"correctness","severity":"medium","confidence":"high","anchor":{"path":"app/routes/admin.py","side":"RIGHT","start_line":33,"end_line":37},"explanation":"The endpoint executes an UPDATE query without checking if any rows were actually affected or if the user exists. If an invalid `user_id` is passed, the database update silently does nothing, but if `notify` is True, `get_user` may return None or raise an error when attempting to access `user.email` on line 37.","suggested_fix":"Check the number of affected rows or verify the user exists before proceeding to send notifications, returning a 404 error if not found.","anchor_in_diff":true,"evidence":[]}],"matches":[{"finding_id":"F1","issue_id":"none-user","distance":0,"verdict":"match","rationale":"location-only matching"}],"expected_total":2,"decoy_hits":[],"review_usage":{"input_tokens":1035,"output_tokens":245,"thinking_tokens":0,"cached_input_tokens":0},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":false,"requests":1,"cached_requests":0,"agent":null,"duration_seconds":1.529,"error":null}
