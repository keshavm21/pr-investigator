{"case_id":"clean-werkzeug-content-type-helper","kind":"clean","sample":0,"findings":[{"id":"F1","title":"Use of helper function before definition","category":"correctness","severity":"high","confidence":"high","anchor":{"path":"src/werkzeug/utils.py","side":"RIGHT","start_line":178,"end_line":178},"explanation":"The function `_wants_charset` is called on line 178 inside `get_content_type`, but it is defined later on line 184. In Python, this will raise a `NameError` at runtime when `get_content_type` is executed.","suggested_fix":"Move the definition of `_wants_charset` above its invocation on line 178.","anchor_in_diff":true,"evidence":[]}],"matches":[],"expected_total":0,"decoy_hits":[],"review_usage":{"input_tokens":1033,"output_tokens":245,"thinking_tokens":0,"cached_input_tokens":0},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":false,"requests":1,"cached_requests":0,"agent":null,"duration_seconds":1.769,"error":null}
