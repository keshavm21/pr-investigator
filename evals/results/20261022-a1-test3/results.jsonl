{"case_id":"decoy-inventory-export-write","kind":"decoy","sample":1,"findings":[{"id":"F1","title":"Creating an export fails with FileNotFoundError if EXPORT_DIR does not exist.","category":"reliability","severity":"medium","confidence":"high","anchor":{"path":"app/routes/exports.py","side":"RIGHT","start_line":39,"end_line":39},"explanation":"When a staff member creates a top-item export via POST /exports/{name}, `path.write_text()` attempts to write to `EXPORT_DIR`. However, neither `EXPORT_DIR` nor its parent directories are ensured to exist (via `mkdir(parents=True, exist_ok=True)`), resulting in an unhandled `FileNotFoundError` and a 500 server error when the directory hasn't been manually created beforehand.","suggested_fix":"Call `path.parent.mkdir(parents=True, exist_ok=True)` before writing to the path.","anchor_in_diff":true,"evidence":[{"role":"defect_site","observation_id":"O9","note":"path.write_text() raises FileNotFoundError if the parent directory (EXPORT_DIR) does not exist","ref":"head","path":"app/routes/exports.py","start_line":39,"end_line":39,"snippet":"    path.write_text(buffer.getvalue())","query":null},{"role":"context","observation_id":"O8","note":"EXPORT_DIR is set to a static path /var/lib/inventory/exports which is never created via mkdir","ref":"head","path":"app/storage.py","start_line":7,"end_line":7,"snippet":"EXPORT_DIR = Path(\"/var/lib/inventory/exports\")","query":null}],"verification":null}],"matches":[],"expected_total":0,"decoy_hits":["F1"],"review_usage":{"input_tokens":24164,"output_tokens":485,"thinking_tokens":0,"cached_input_tokens":4009},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":true,"requests":6,"cached_requests":6,"agent":{"suspects":0,"dropped_suspects":0,"outcomes":{},"stop_causes":{"submitted":1},"turns":6,"tool_calls":5,"rejections":0,"duplicates":0,"retries":0},"duration_seconds":0.039,"error":null}
