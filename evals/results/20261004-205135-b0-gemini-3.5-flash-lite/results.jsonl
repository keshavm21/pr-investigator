{"case_id":"seeded-missing-authorization","kind":"seeded","sample":0,"findings":[{"id":"F1","title":"Missing role authorization check on bulk price update endpoint","category":"security","severity":"high","confidence":"high","anchor":{"path":"app/routes/items.py","side":"RIGHT","start_line":50,"end_line":52},"explanation":"The endpoint uses only the @require_login decorator rather than checking if the user has pricing or admin roles, allowing any authenticated user to modify the prices of all items.","suggested_fix":"Add @require_role('admin') or equivalent role check.","anchor_in_diff":true}],"matches":[{"finding_id":"F1","issue_id":"authz","distance":0,"verdict":"match","rationale":"location-only matching"}],"expected_total":1,"decoy_hits":[],"review_usage":{"input_tokens":908,"output_tokens":196,"thinking_tokens":0,"cached_input_tokens":0},"judge_usage":{"input_tokens":0,"output_tokens":0,"thinking_tokens":0,"cached_input_tokens":0},"cached":false,"duration_seconds":53.69,"error":null}
