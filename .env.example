# Copy to .env (gitignored) and fill in. Never commit real keys.

# Gemini API key from Google AI Studio. Use a project WITHOUT billing so going over
# the free quota fails with HTTP 429 instead of costing money.
GEMINI_API_KEY=

# Optional: raises GitHub's API rate limit for public repositories.
# Example: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Evaluation model (D3). The official B0 baseline and Phase 2 comparisons use it.
# The code default is still gemini-3.8-flash, so keep this line set.
PRI_LLM_MODEL=gemini-3.5-flash-lite

# Optional overrides (defaults shown).
# PRI_LLM_PROVIDER=gemini
# PRI_LLM_REQUESTS_PER_MINUTE=5
# PRI_LLM_CACHE_MODE=read_write
